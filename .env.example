# ==============================================================================
# F-096 AI Service Environment Configuration Template
# Copy this file to .env and populate with your credentials.
# NEVER commit .env or real secret keys to the version control repository!
# ==============================================================================

# LLM Provider Configuration for Resume Skill Extraction
# Supported providers: OpenAI, Gemini, or any OpenAI-compatible HTTP inference API
LLM_API_KEY=
LLM_MODEL_NAME=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# AI Recommendation Microservice Configuration
AI_SERVICE_PORT=8000
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_ENV=development

# Optional Model Serialization Directory Override (defaults to model/saved_models)
# MODEL_DIR=./model/saved_models
